<robot name="simple_cart">
  <!-- =====================================================
       CART BODY
       ===================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.70 0.50 0.30"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.70 0.50 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="10.0"/>
      <inertia ixx="0.283" ixy="0.0" ixz="0.0" iyy="0.483" iyz="0.0" izz="0.617"/>
    </inertial>
  </link>
  <!-- =====================================================
       SIMPLE PLANAR MOVEMENT PLUGIN
       ===================================================== -->
  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="planar_move">
      <ros>
        <namespace>
          /cart_3
        </namespace>
      </ros>
      <update_rate>50.0</update_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
