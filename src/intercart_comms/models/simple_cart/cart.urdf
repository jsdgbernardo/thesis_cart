<?xml version="1.0"?>

<robot name="simple_cart">

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.70 0.50 0.30"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.70 0.50 0.30"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.283"
        ixy="0.0"
        ixz="0.0"
        iyy="0.483"
        iyz="0.0"
        izz="0.617"/>
    </inertial>

  </link>

</robot>